<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(DefaultLibraryTargetFrameworks)</TargetFrameworks>
        <PackageId>ZCS.Utf8Json.ImmutableCollection</PackageId>
        <Title>ZCS.Utf8Json Extension Resolver for ImmutableCollection</Title>
        <Description>Add ImmutableCollection formatters to ZCS.Utf8Json.</Description>
        <IsPackable>true</IsPackable>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>opensource.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <!-- In-box on .NET 8+ (part of the shared framework); only netstandard needs the package. -->
    <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <PackageReference Include="System.Collections.Immutable" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Utf8Json\Utf8Json.csproj" />
    </ItemGroup>

</Project>
